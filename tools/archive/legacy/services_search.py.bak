from __future__ import annotations

import re
from dataclasses import dataclass
from difflib import SequenceMatcher
from typing import Iterable

from services.catalogue import ITEMS, RESTAURANTS, Item, Restaurant
from services.distance import haversine_km
from services.eta import estimate_eta_minutes


@dataclass(frozen=True)
class SearchQuery:
    dish: str
    budget: int | None = None
    veg_only: bool = False
    limit: int = 10


@dataclass(frozen=True)
class SearchResult:
    item: Item
    restaurant: Restaurant
    distance_km: float
    eta_min: int
    eta_max: int
    score: float


FILLER_PATTERNS = [
    r"\bi am hungry\b",
    r"\bi'm hungry\b",
    r"\bi want\b",
    r"\bi need\b",
    r"\bgive me\b",
    r"\bshow me\b",
    r"\border\b",
    r"\bfind\b",
]


def normalize_text(text: str) -> str:
    text = text.lower().strip()

    for pattern in FILLER_PATTERNS:
        text = re.sub(pattern, " ", text)

    text = re.sub(r"\bunder\s*₹?\s*\d+\b", " ", text)
    text = re.sub(r"\bbelow\s*₹?\s*\d+\b", " ", text)
    text = re.sub(r"\bmax\s*₹?\s*\d+\b", " ", text)
    text = re.sub(r"\bwithin\s*₹?\s*\d+\b", " ", text)
    text = re.sub(r"[^\w\s]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def parse_budget(text: str) -> int | None:
    text = text.lower()
    patterns = [
        r"(?:under|below|within|max)\s*₹?\s*(\d+)",
        r"₹\s*(\d+)",
        r"rs\.?\s*(\d+)",
    ]

    for pattern in patterns:
        match = re.search(pattern, text)
        if match:
            return int(match.group(1))

    return None


def parse_veg_only(text: str) -> bool:
    text = text.lower()
    veg_markers = ["veg", "vegetarian", "pure veg"]
    non_veg_markers = ["non veg", "non-veg", "chicken", "mutton", "fish", "egg"]

    if any(x in text for x in non_veg_markers):
        return False
    return any(x in text for x in veg_markers)


def build_query(text: str, limit: int = 10) -> SearchQuery:
    return SearchQuery(
        dish=normalize_text(text),
        budget=parse_budget(text),
        veg_only=parse_veg_only(text),
        limit=limit,
    )


def _score_candidate(query: str, item: Item) -> float:
    query = query.strip().lower()
    if not query:
        return 0.0

    fields = [
        item.name.lower(),
        item.description.lower(),
        item.category.lower(),
        *[a.lower() for a in item.aliases],
    ]

    best = 0.0

    for field in fields:
        if not field:
            continue

        if query == field:
            best = max(best, 1.0)
            continue

        if query in field or field in query:
            best = max(best, 0.92)

        ratio = SequenceMatcher(None, query, field).ratio()
        best = max(best, ratio)

        query_tokens = set(query.split())
        field_tokens = set(field.split())
        if query_tokens and field_tokens:
            overlap = len(query_tokens & field_tokens) / len(query_tokens)
            best = max(best, overlap * 0.9)

    return best


def _iter_candidates() -> Iterable[Item]:
    for item in ITEMS.values():
        yield item


def search_items(
    user_text: str,
    user_lat: float,
    user_lon: float,
    limit: int = 10,
    min_score: float = 0.45,
) -> list[SearchResult]:
    query = build_query(user_text, limit=limit)
    results: list[SearchResult] = []

    for item in _iter_candidates():
        restaurant = RESTAURANTS.get(item.restaurant_id)
        if not restaurant:
            continue

        if not restaurant.is_open:
            continue

        if not item.available:
            continue

        if query.veg_only and not item.veg:
            continue

        if query.budget is not None and item.price > query.budget:
            continue

        distance_km = haversine_km(user_lat, user_lon, restaurant.lat, restaurant.lon)
        if distance_km > restaurant.radius_km:
            continue

        score = _score_candidate(query.dish, item)
        if score < min_score:
            continue

        eta_min, eta_max = estimate_eta_minutes(distance_km, restaurant)

        score += min(restaurant.rating / 25.0, 0.2)
        score += max(0.0, 0.15 - (distance_km / 50.0))

        results.append(
            SearchResult(
                item=item,
                restaurant=restaurant,
                distance_km=round(distance_km, 2),
                eta_min=eta_min,
                eta_max=eta_max,
                score=round(score, 4),
            )
        )

    results.sort(
        key=lambda r: (
            -r.score,
            r.item.price,
            r.distance_km,
            -r.restaurant.rating,
        )
    )

    return results[:query.limit]


def format_result(result: SearchResult) -> str:
    veg_label = "Veg" if result.item.veg else "Non-veg"
    return (
        f"{result.item.name} — {result.restaurant.name}\n"
        f"Price: ₹{result.item.price}\n"
        f"Rating: {result.restaurant.rating:.1f}\n"
        f"Distance: {result.distance_km:.2f} km\n"
        f"ETA: {result.eta_min}-{result.eta_max} min\n"
        f"Category: {result.item.category}\n"
        f"Type: {veg_label}"
    )